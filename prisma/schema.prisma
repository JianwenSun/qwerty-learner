generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:root@127.0.0.1:3306/qwerty_learner"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  describe  String
  createAt  DateTime  @default(now()) @map("create_at")
  modifyAt  DateTime? @map("modify_at")
  deleteAt  DateTime? @map("delete_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  @@map("categories")
}

model Chapter {
  id           Int         @id @default(autoincrement())
  name         String
  describe     String
  type         ChapterType
  dictionaryId Int         @map("dictionary_id")
  createAt     DateTime    @default(now()) @map("create_at")
  modifyAt     DateTime?   @map("modify_at")
  deleteAt     DateTime?   @map("delete_at")
  isDeleted    Boolean     @default(false) @map("is_deleted")
  dictionary   Dictionary  @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  passages     Passage[]
  sentences    Sentence[]

  @@index([dictionaryId], map: "chapters_dictionary_id_fkey")
  @@map("chapters")
}

model Word {
  id           Int       @id @default(autoincrement())
  content      String    @unique
  ukphone      String
  usphone      String
  createAt     DateTime  @default(now()) @map("create_at")
  modifyAt     DateTime? @map("modify_at")
  deleteAt     DateTime? @map("delete_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  senses       Senses?

  @@index([content])
  @@map("words")
}

model Clause {
  id           Int        @id @default(autoincrement())
  sentenceId   Int        @map("sentence_id")
  index        Int
  type         ClauseType
  explanation  String
  chunkIndexes String     @map("chunk_indexes")
  createAt     DateTime   @default(now()) @map("create_at")
  modifyAt     DateTime?  @map("modify_at")
  deleteAt     DateTime?  @map("delete_at")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  sentence     Sentence   @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@index([sentenceId], map: "clauses_sentence_id_fkey")
  @@map("clauses")
}

model Sentence {
  id          Int        @id @default(autoincrement())
  chapterId   Int?       @map("chapter_id")
  content     String
  contentCn   String     @map("content_cn")
  explanation String?
  tokens      String     @map("tokens") @db.Text
  words       String     @map("words") @db.Text
  createAt    DateTime   @default(now()) @map("create_at")
  modifyAt    DateTime?  @map("modify_at")
  deleteAt    DateTime?  @map("delete_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  clauses     Clause[]
  chapter     Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  passages    Passage[]  @relation("PassageSentence")
  practices   Practice[] @relation("SentencePractice")
  sentenceSounds SentenceSound[]

  @@index([content])
  @@index([chapterId], map: "sentences_chapter_id_fkey")
  @@map("sentences")
}

model Dictionary {
  id         Int       @id @default(autoincrement())
  name       String
  describe   String
  imageUrl   String    @map("image_url")
  categoryId Int       @map("category_id")
  chapterNum Int       @map("chapter_num")
  createAt   DateTime  @default(now()) @map("create_at")
  modifyAt   DateTime? @map("modify_at")
  deleteAt   DateTime? @map("delete_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  chapters   Chapter[]

  @@map("dictionaries")
}

// Sound 表已被重新定义，原表已删除

model Practice {
  id        Int        @id @default(autoincrement())
  name      String
  createAt  DateTime   @default(now()) @map("create_at")
  modifyAt  DateTime?  @map("modify_at")
  deleteAt  DateTime?  @map("delete_at")
  isDeleted Boolean    @default(false) @map("is_deleted")
  sentences Sentence[] @relation("SentencePractice")

  @@index([name])
  @@map("practices")
}

model Passage {
  id            Int        @id @default(autoincrement())
  title         String
  content       String     @db.Text
  contentCn     String     @map("content_cn") @db.Text
  author        String?
  source        String
  wordCount     Int        @map("word_count")
  sentenceCount Int        @map("sentence_count")
  createAt      DateTime   @default(now()) @map("create_at")
  modifyAt      DateTime?  @map("modify_at")
  deleteAt      DateTime?  @map("delete_at")
  isDeleted     Boolean    @default(false) @map("is_deleted")
  chapterId     Int?       @map("chapter_id")
  chapter       Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sentences     Sentence[] @relation("PassageSentence")

  @@index([title])
  @@index([chapterId], map: "passages_chapter_id_fkey")
  @@map("passages")
}

enum ChapterType {
  Word
  Sentence
  Passage
}

enum ClauseType {
  Simple
  Complex
}

enum VoiceType {
  Male
  Female
}

model Sound {
  id         String    @id @default(cuid())
  voiceType  VoiceType @map("voice_type")
  gender     String    @map("gender")
  url        String?   @map("url")
  mp3Data    Bytes?    @map("mp3_data")
  createAt   DateTime  @default(now()) @map("create_at")
  modifyAt   DateTime? @map("modify_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  sentenceSounds SentenceSound[]
  sensesSounds   SensesSound[]
  senseSounds    SenseSound[]
  sensess        Senses[]
  @@map("sounds")
}

model Senses {
  id        Int       @id @default(autoincrement())
  wordId    Int       @unique @map("word_id")
  ukphone   String
  usphone   String
  soundId   String?   @map("sound_id")
  createAt  DateTime  @default(now()) @map("create_at")
  modifyAt  DateTime? @map("modify_at")
  deleteAt  DateTime? @map("delete_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sound     Sound?    @relation(fields: [soundId], references: [id], onDelete: SetNull)
  sense     Sense[]
  sensesSounds SensesSound[]

  @@index([wordId], map: "senses_word_id_fkey")
  @@index([soundId], map: "senses_sound_id_fkey")
  @@map("senses")
}

model Sense {
  id        Int       @id @default(autoincrement())
  content   String
  pos       String
  ukphone   String?
  usphone   String?
  sensesId  Int       @map("senses_id")
  createAt  DateTime  @default(now()) @map("create_at")
  modifyAt  DateTime? @map("modify_at")
  deleteAt  DateTime? @map("delete_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  senses    Senses    @relation(fields: [sensesId], references: [id], onDelete: Cascade)
  senseSounds SenseSound[]

  @@index([sensesId], map: "sense_senses_id_fkey")
  @@map("sense")
}

model SentenceSound {
  sentenceId Int    @map("sentence_id")
  soundId    String @map("sound_id")
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  sound      Sound    @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@id([sentenceId, soundId])
  @@map("sentence_sounds")
}

model SensesSound {
  sensesId  Int    @map("senses_id")
  soundId  String @map("sound_id")
  senses    Senses  @relation(fields: [sensesId], references: [id], onDelete: Cascade)
  sound    Sound  @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@id([sensesId, soundId])
  @@map("senses_sounds")
}

model SenseSound {
  senseId  Int    @map("sense_id")
  soundId  String @map("sound_id")
  sense    Sense  @relation(fields: [senseId], references: [id], onDelete: Cascade)
  sound    Sound  @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@id([senseId, soundId])
  @@map("sense_sounds")
}
