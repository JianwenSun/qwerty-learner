generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:root@127.0.0.1:3306/qwerty_learner"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  describe  String
  createAt  DateTime  @default(now()) @map("create_at")
  modifyAt  DateTime? @map("modify_at")
  deleteAt  DateTime? @map("delete_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  @@map("categories")
}

model Chapter {
  id           Int         @id @default(autoincrement())
  name         String
  describe     String
  type         ChapterType
  dictionaryId Int         @map("dictionary_id")
  createAt     DateTime    @default(now()) @map("create_at")
  modifyAt     DateTime?   @map("modify_at")
  deleteAt     DateTime?   @map("delete_at")
  isDeleted    Boolean     @default(false) @map("is_deleted")
  dictionary   Dictionary  @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  passages     Passage[]
  sentences    Sentence[]

  @@index([dictionaryId], map: "chapters_dictionary_id_fkey")
  @@map("chapters")
}

model Word {
  id           Int       @id @default(autoincrement())
  content      String    @unique
  tokenIndexes String    @map("token_indexes")
  senseIds     String    @map("sense_ids")
  createAt     DateTime  @default(now()) @map("create_at")
  modifyAt     DateTime? @map("modify_at")
  deleteAt     DateTime? @map("delete_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  @@index([content])
  @@map("words")
}

model Clause {
  id           Int        @id @default(autoincrement())
  sentenceId   Int        @map("sentence_id")
  index        Int
  type         ClauseType
  explanation  String
  chunkIndexes String     @map("chunk_indexes")
  createAt     DateTime   @default(now()) @map("create_at")
  modifyAt     DateTime?  @map("modify_at")
  deleteAt     DateTime?  @map("delete_at")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  sentence     Sentence   @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@index([sentenceId], map: "clauses_sentence_id_fkey")
  @@map("clauses")
}

model Sentence {
  id          Int        @id @default(autoincrement())
  chapterId   Int?       @map("chapter_id")
  content     String
  contentCn   String     @map("content_cn")
  explanation String
  tokens      String     @map("tokens") @db.Text
  words       String     @map("words") @db.Text
  soundId     Int        @map("sound_id")
  createAt    DateTime   @default(now()) @map("create_at")
  modifyAt    DateTime?  @map("modify_at")
  deleteAt    DateTime?  @map("delete_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  clauses     Clause[]
  chapter     Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  passages    Passage[]  @relation("PassageSentence")
  practices   Practice[] @relation("SentencePractice")

  @@index([content])
  @@index([chapterId], map: "sentences_chapter_id_fkey")
  @@map("sentences")
}

model Dictionary {
  id         Int       @id @default(autoincrement())
  name       String
  describe   String
  imageUrl   String    @map("image_url")
  categoryId Int       @map("category_id")
  chapterNum Int       @map("chapter_num")
  createAt   DateTime  @default(now()) @map("create_at")
  modifyAt   DateTime? @map("modify_at")
  deleteAt   DateTime? @map("delete_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  chapters   Chapter[]

  @@map("dictionaries")
}

model Sound {
  id        Int       @id @default(autoincrement())
  path      String
  createAt  DateTime  @default(now()) @map("create_at")
  modifyAt  DateTime? @map("modify_at")
  deleteAt  DateTime? @map("delete_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  @@map("sounds")
}

model Practice {
  id        Int        @id @default(autoincrement())
  name      String
  createAt  DateTime   @default(now()) @map("create_at")
  modifyAt  DateTime?  @map("modify_at")
  deleteAt  DateTime?  @map("delete_at")
  isDeleted Boolean    @default(false) @map("is_deleted")
  sentences Sentence[] @relation("SentencePractice")

  @@index([name])
  @@map("practices")
}

model Passage {
  id            Int        @id @default(autoincrement())
  title         String
  content       String
  contentCn     String     @map("content_cn")
  author        String?
  source        String
  wordCount     Int        @map("word_count")
  sentenceCount Int        @map("sentence_count")
  createAt      DateTime   @default(now()) @map("create_at")
  modifyAt      DateTime?  @map("modify_at")
  deleteAt      DateTime?  @map("delete_at")
  isDeleted     Boolean    @default(false) @map("is_deleted")
  chapterId     Int?       @map("chapter_id")
  chapter       Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sentences     Sentence[] @relation("PassageSentence")

  @@index([title])
  @@index([chapterId], map: "passages_chapter_id_fkey")
  @@map("passages")
}

enum ChapterType {
  Word
  Sentence
  Passage
}

enum ClauseType {
  Simple
  Complex
}
